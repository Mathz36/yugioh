{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "esModuleInterop": true,
    "strict": true,
    "skipLibCheck": true,
    "jsx": "react-jsx",
    "baseUrl": ".",
    "paths": {
      "@duel/*": ["src/duel/*"]
    }
  },
  "include": ["scripts/**/*", "src/**/*", "client/**/*"]
}

