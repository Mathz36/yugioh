{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/api/card-image/(.*)",
      "destination": "https://images.ygoprodeck.com/images/cards/$1"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
